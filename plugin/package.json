{
  "name": "@local/voice-server-lifecycle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Starts the local Qwen3-TTS voice server with the app and stops it on exit.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
